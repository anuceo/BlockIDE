{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "blockchain-ide",
  "version": "0.3.0",
  "identifier": "com.blockchain.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Blockchain IDE",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "category": "DeveloperTool",
    "targets": "all"
  }
}

